{
  "name": "workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm clean && pnpm build:client && pnpm build:server && pnpm build:manifest",
    "build:client": "cross-env BUILD_TARGET=client vite build",
    "build:manifest": "node -e \"require('node:fs').copyFileSync('appsscript.json','dist/appsscript.json')\"",
    "build:server": "cross-env BUILD_TARGET=server vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "console": "gasboost console open",
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@gasboost/app": "^5.5.0",
    "@gasboost/auth": "^0.12.0",
    "@gasboost/auth-app": "^0.9.0",
    "@gasboost/auth-client": "^0.8.1",
    "@gasboost/auth-sheetorm": "^0.5.1",
    "@gasboost/bootstrap": "^0.5.0",
    "@gasboost/client": "^0.7.0",
    "@gasboost/react": "^0.4.3",
    "@gasboost/sheetorm": "^4.0.0",
    "@gasboost/table": "^0.2.0",
    "@hookform/resolvers": "^7.0.9",
    "@tanstack/react-query": "^5.108.4",
    "awilix": "^13.0.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.7",
    "shadcn": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gasboost/cli": "^0.3.12",
    "@gasboost/config": "^0.2.0",
    "@gasboost/fake-core": "^0.4.0",
    "@gasboost/fake-node": "^0.3.0",
    "@gasboost/vite": "^1.6.1",
    "@google/clasp": "^3.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/google-apps-script": "^2.0.15",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.18.0"
}
